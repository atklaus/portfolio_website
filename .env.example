# Copy to .env and fill in values for local runs that use cloud storage.
# Streamlit can also load secrets from .streamlit/secrets.toml.

# Cloudflare R2 (S3-compatible) credentials
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET=your-bucket
R2_REGION=auto

# Optional: set to your local hostname to filter analytics locally
LOCAL_DEV_HOSTNAME=your_hostname

# Telemetry logging
LOGGING_ENABLED=true
LOG_SINK=stdout+r2
LOG_FLUSH_EVENTS=25
LOG_FLUSH_SECONDS=5
LOG_SESSION_FLUSH_SECONDS=60
APP_VERSION=dev

# Google Analytics 4 (optional)
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Site base URL (used for sitemap and meta)
SITE_URL=https://databuilds.dev

# Legacy aliases (optional). R2_* values are preferred.
SPACES_BUCKET=
SPACES_REGION=
SPACES_ENDPOINT=
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

# Optional: s3cmd configuration if you use .s3cfg with env substitution
S3CFG_GPG_PASSPHRASE=your_passphrase
